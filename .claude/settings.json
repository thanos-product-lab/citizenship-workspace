{
  "permissions": {
    "allow": [
      "Bash(just *)",
      "Bash(pnpm *)",
      "Bash(uv *)",
      "Bash(pytest *)",
      "Bash(alembic *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(alembic downgrade *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Edit(packages/api-client/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/protect-immutables.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/rules-guard.sh" }
        ]
      }
    ]
  }
}
