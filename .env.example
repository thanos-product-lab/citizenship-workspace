# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself.
# Never commit a real .env — it is gitignored.

ENVIRONMENT=local

# Sync drivers: psycopg3 for Postgres, redis-py for Redis.
DATABASE_URL=postgresql+psycopg://citizenship:citizenship@localhost:5432/citizenship
REDIS_URL=redis://localhost:6379/0

# Signs the upload token that carries an evidence file's storage key back from the
# browser (ADR-0019). Unset is tolerated only when ENVIRONMENT is local/docker/test;
# anywhere else the API refuses to boot. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
UPLOAD_TOKEN_SECRET=

# Private object storage for evidence files (MinIO locally; any S3 in deployment).
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=citizenship-evidence
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
