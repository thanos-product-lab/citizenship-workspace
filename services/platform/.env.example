# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself.
# Never commit a real .env — it is gitignored.

ENVIRONMENT=local

# Sync drivers: psycopg3 for Postgres, redis-py for Redis.
DATABASE_URL=postgresql+psycopg://citizenship:citizenship@localhost:5432/citizenship
REDIS_URL=redis://localhost:6379/0

# Signs the upload token that carries an evidence file's storage key back from the
# browser (ADR-0019). Unset is tolerated only when ENVIRONMENT is local/docker/test;
# anywhere else the API refuses to boot. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
UPLOAD_TOKEN_SECRET=

# Private object storage for evidence files (MinIO locally; any S3 in deployment).
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=citizenship-evidence
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- AI provider -------------------------------------------------------------
# Required outside local development; the API and the worker both need it.
# `check_ai_configuration` refuses to boot without it, because a missing key does
# not crash anything - it just makes every document fail at the extraction stage
# while the API keeps reporting itself ready.
OPENAI_API_KEY=

# `fake` returns synthetic structured output for local work without a key. It is
# refused outside local environments: a deployment running on it would present
# fabricated values as model proposals and nothing downstream could tell.
AI_PROVIDER=openai

# One provider call, and the budget for all the calls one task makes. The second is
# the bound that matters - Celery kills the *task* (soft limit 60s), and a document
# takes two calls. See docs/evaluations/AI_SPIKE_FINDINGS.md section 4.
AI_REQUEST_TIMEOUT_SECONDS=15
AI_TASK_DEADLINE_SECONDS=45
AI_MAX_ATTEMPTS=3

# USD per UTC day, deployment-wide, hard stop. At the ~$0.00026 per document the
# spike measured this is thousands of documents: it does not bound ordinary use, it
# bounds a loop.
AI_DAILY_SPEND_CEILING_USD=5.0

# Enables POST /health/ai-probe, which makes one real model call so the deployed
# smoke can tell a working key from a well-formed one. Unset disables the endpoint
# entirely - an unauthenticated route that spends money is not something to leave on
# by default. Must match the smoke's SMOKE_AI_PROBE_SECRET.
AI_PROBE_SECRET=

# --- Auth (Clerk) ------------------------------------------------------------
# The API derives the JWKS URL from the issuer, so CLERK_JWKS_URL is only needed
# to override that. Verification fails closed when unconfigured: no issuer means
# no token verifies, rather than every token verifying.
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
# Comma-separated `azp` allow-list, e.g. http://localhost:3000
CLERK_AUTHORIZED_PARTIES=

# --- Service ------------------------------------------------------------------
SERVICE_NAME=citizenship-platform
# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Storage, remaining -------------------------------------------------------
# `memory` selects the in-process fake, which exists so the seed and the
# non-storage test suites do not need a running MinIO. It asserts behaviour only
# and must never be used to claim a security property.
STORAGE_BACKEND=s3
STORAGE_REGION=us-east-1
# The address the *browser* reaches the store at, when it differs from the one the
# server uses. Unset means they are the same, which is the deployed case. Local
# compose sets it because the API reaches MinIO at `minio:9000` over the docker
# network, and that hostname does not resolve on the host.
STORAGE_PUBLIC_ENDPOINT_URL=
# Presigned URLs cannot be revoked, so this is the whole bound on an issued URL's
# life (ADR-0018). Long enough to follow a redirect, too short to pass on.
STORAGE_PRESIGN_TTL_SECONDS=60
# Hard ceiling on an uploaded file, in bytes. Enforced at presign and again at
# completion — a client controls what it declares, not what the store reports.
MAX_UPLOAD_BYTES=20971520
